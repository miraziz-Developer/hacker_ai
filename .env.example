# Never commit real credentials. Entra ID is the recommended default.
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_AUTH=entra
# Only set this for AZURE_OPENAI_AUTH=api_key. Prefer Azure Key Vault.
# AZURE_OPENAI_API_KEY=retrieve-from-a-secret-store
HACKER_AI_TIMEOUT_SECONDS=30
# Additional kill switch; true still requires imported scope, policy checks, and --execute.
HACKER_AI_ALLOW_NETWORK_EXECUTION=false
# Telegram is an interface, not a scope or execution-gate bypass.
# TELEGRAM_BOT_TOKEN=retrieve-from-a-secret-store
# TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# Telegram recon capabilities default to false and can be enabled independently.
HACKER_AI_TELEGRAM_ALLOW_HTTP_RECON=false
HACKER_AI_TELEGRAM_ALLOW_SUBDOMAIN_RECON=false
HACKER_AI_TELEGRAM_ALLOW_PORT_RECON=false
# Scope, exclusions, policy, confirmation, audit, and safe adapters cannot be disabled here.
